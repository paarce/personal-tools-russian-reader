   "tipo": "gramatica",
   "tema": "Género de los sustantivos",
   "explicacion": "Cada sustantivo ruso es masculino, femenino o neutro, y ese género rige los adjetivos, los pronombres y las declinaciones que vendrán después. La terminación del diccionario casi siempre lo delata — pero hay un puñado de palabras donde el significado manda sobre la forma.",
   "reglas": [
    {
     "regla": "Consonante final → masculino",
     "ejemplos": "дом · стол · хлеб"
    },
    {
     "regla": "-а / -я → femenino",
     "ejemplos": "книга · семья · сестра"
    },
    {
     "regla": "-о / -е → neutro",
     "ejemplos": "окно · время"
    },
    {
     "regla": "Excepción: manda el significado, no la letra",
     "ejemplos": "мама (fem.) · папа (masc.) — ambas en -а"
    }
   ],
   "frases": [
    {
     "ru": "Это мой дом.",
     "ru_stress": "Э́то мой дом.",
     "es": "Esta es mi casa.",
     "nota": "дом termina en consonante → masculino"
    },
    {
     "ru": "Это твоя книга.",
     "ru_stress": "Э́то твоя́ кни́га.",
     "es": "Este es tu libro.",
     "nota": "книга termina en -а → femenino"
    },
    {
     "ru": "Это моё окно.",
     "ru_stress": "Э́то моё окно́.",
