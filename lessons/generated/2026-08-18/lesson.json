  {
   "n": 3,
   "titulo": "Gramática en contexto",
   "minutos": 6,
   "tipo": "gramatica",
   "tema": "Género de los sustantivos",
   "explicacion": "En ruso todo sustantivo tiene un género fijo: masculino, femenino o neutro. La terminación casi siempre lo delata, y el posesivo мой / моя / моё tiene que concordar con ese género, no con quién habla. Las palabras terminadas en -ь son la excepción: no hay regla visual, hay que memorizarlas una por una.",
   "reglas": [
    {
     "regla": "Consonante → masculino",
     "ejemplos": "дом · брат · день"
    },
    {
     "regla": "-а / -я → femenino",
     "ejemplos": "мама · семья · сестра"
    },
    {
     "regla": "-о / -е → neutro",
     "ejemplos": "окно · молоко · время"
    },
    {
     "regla": "-ь → depende, se memoriza",
     "ejemplos": "день (m) · дверь (f)"
    }
   ],
   "frases": [
    {
     "ru": "Это мой дом.",
     "ru_stress": "Э́то мой дом.",
     "es": "Esta es mi casa.",
     "nota": "дом termina en consonante → masculino, por eso «мой»."
    },
    {
     "ru": "Это моя мама.",
     "ru_stress": "Э́то моя́ ма́ма.",
     "es": "Esta es mi mamá.",
     "nota": "мама termina en -а → femenino, por eso «моя»."
    },
    {
     "ru": "Это моя семья.",
     "ru_stress": "Э́то моя́ семья́.",
     "es": "Esta es mi familia.",
     "nota": "семья termina en -я, también femenino, igual que -а."
    },
    {
     "ru": "Это моё окно.",
     "ru_stress": "Э́то моё окно́.",
     "es": "Esta es mi ventana.",
     "nota": "окно termina en -о → neutro, por eso «моё»."
    },
    {
     "ru": "Это мой день.",
     "ru_stress": "Э́то мой день.",
     "es": "Este es mi día.",
     "nota": "день termina en -ь pero es masculino: no hay regla, se memoriza."
    },
    {
